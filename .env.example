# Copy to .env. tools/register_desk.py and tools/create_rooms.py fill in the ids and the desk key.
SWITCH_URL=http://127.0.0.1:8000
SWITCH_EMAIL=
SWITCH_PASSWORD=

FOUNDRY_DESK_ID=
FOUNDRY_DESK_KEY=
# outside:studio:review, comma-separated. Internal mode names its projects room twice.
FOUNDRY_ROOMS=

# Leave empty and whoever asks approves their own job. A business can set its own in its pack.md.
# Use the Switch sender id: @switch-mattermost-<bridge id>-<username>:localhost
# or @switch-whatsapp-<bridge id>-<lowercase name>_<number>:localhost
FOUNDRY_APPROVER=
FOUNDRY_QUIET_SECONDS=60
# off, subtle or playful
FOUNDRY_STICKER_MODE=subtle
# A job stops and asks a person if the team has said nothing for this long.
FOUNDRY_WORK_TIMEOUT_MINUTES=30

# Reads voice notes, and speaks replies to whoever sent one. Costs per call.
SARVAM_API_KEY=
# Reads each burst of chat. Leave empty to use this machine's Claude Code login instead.
ANTHROPIC_API_KEY=
FOUNDRY_CLASSIFIER_MODEL=claude-haiku-5-5
# The reviewer should not be the makers' vendor. Empty means OpenCode's free model, or Codex if OpenCode is missing.
# The free tier has a usage limit. When it runs out, the job stops and asks a person.
FOUNDRY_REVIEWER_PROVIDER=
# A model that can see images. Empty means the provider's own default.
FOUNDRY_REVIEWER_MODEL=

# Which brand's pack each outside room uses, as room:brand-slug. tools/create_rooms.py writes it.
FOUNDRY_PACKS=
FOUNDRY_REPORTS_DB=foundry-reports.db
# Writes reports from notes. A smaller model got dates wrong in testing.
FOUNDRY_CLEANUP_MODEL=claude-sonnet-5-5
# The business's time zone. Dates in reports count from the day a note was sent there. 330 is India.
FOUNDRY_UTC_OFFSET_MINUTES=330

# Only with integrations/whatsapp. From your Meta app. tools/connect_whatsapp.py reads them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
