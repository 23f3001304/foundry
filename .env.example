# Copy to .env. tools/register_desk.py and tools/create_rooms.py fill in the ids and the desk key.
SWITCH_URL=http://127.0.0.1:8000
SWITCH_EMAIL=
SWITCH_PASSWORD=

FOUNDRY_DESK_ID=
FOUNDRY_DESK_KEY=
# outside:studio:review[:ending], comma-separated. Internal mode names its projects room twice. An agency client's agents have names that end with its ending, such as -phatakha, so the desk asks that client's own agents. A room with no ending uses the shared agents.
FOUNDRY_ROOMS=

# Leave empty and whoever asks approves their own job. A business can set its own in its pack.md.
# Use the Switch sender id: @switch-mattermost-<bridge id>-<username>:localhost
# or @switch-whatsapp-<bridge id>-<lowercase name>_<number>:localhost
FOUNDRY_APPROVER=
# The bridge id in those Mattermost sender ids. A pack's approver can write it as {bridge}, and a business that takes daily notes names its approver that way.
FOUNDRY_MATTERMOST_BRIDGE=
FOUNDRY_QUIET_SECONDS=60
# off, subtle or playful
FOUNDRY_STICKER_MODE=subtle
# A job stops and asks a person if the team has said nothing for this long.
FOUNDRY_WORK_TIMEOUT_MINUTES=30

# Reads voice notes, and speaks replies to whoever sent one. Costs per call.
SARVAM_API_KEY=
# Reads each burst of chat. Leave empty to use this machine's Claude Code login instead.
ANTHROPIC_API_KEY=
FOUNDRY_CLASSIFIER_MODEL=claude-haiku-5-5
# The reviewer should not be the makers' vendor. Codex must be signed in and on PATH where the agent controller starts.
# Empty means OpenCode's free model, or Codex if OpenCode is missing. That free tier has a usage limit. When it runs out, the job stops and asks a person.
# Claude for now, because Codex's usage has run out until Dec 4. Leave the model empty with Claude. Set this before scripts/demo_seed.py makes the rooms, because a reviewer's provider can't be changed once it is made.
FOUNDRY_REVIEWER_PROVIDER=claude
# A model that can see images. Empty means the provider's own default.
# An agent's provider is fixed when it is registered. Each agency client gets its own reviewer, made with whatever these two say at that moment, and an existing one is never changed.
FOUNDRY_REVIEWER_MODEL=

# Picture drawing is off. Set it to on and the makers get a generate_image tool, which calls the same Vertex image model as tools/gen_assets.py. It needs GOOGLE_CLOUD_PROJECT and a gcloud sign-in (gcloud auth application-default login), and every picture costs money. Set it before the rooms are made. To change it later, run this once for each agency client, with the full path of its brand folder: uv run --env-file .env python tools/setup_makers.py <agents folder> -<client> <brand folder>, where the ending is like -phatakha and the brand folder is the full path of the client's folder under brands. For the shared makers, run it with only the agents folder. The agents folder is the agent controller's workspaces_dir.
# With it off, a campaign set still comes out complete, and its written copy says no pictures were drawn.
FOUNDRY_IMAGES=off
GOOGLE_CLOUD_PROJECT=
# Leave empty for the model tools/gen_assets.py names.
FOUNDRY_IMAGE_MODEL=

# Which brand's pack each outside room uses, as room:brand-slug. tools/create_rooms.py writes it.
FOUNDRY_PACKS=
# Everything that reaches or leaves the desk, one bucket per client. It only grows and nothing deletes from it.
FOUNDRY_LOG_DB=foundry-log.db
# Open items and queued cards.
FOUNDRY_WORK_DB=foundry-work.db
# Files people send as answers, one folder for each client and job. The data tools open them from here.
FOUNDRY_INPUTS_DIR=foundry-inputs
# Beats every pack's set times for routine cards, for short live runs. Comma-separated, such as 14:05,14:10. Leave empty to use the packs'.
FOUNDRY_SET_TIMES=
# Writes reports from notes. A smaller model got dates wrong in testing.
FOUNDRY_CLEANUP_MODEL=claude-sonnet-5-5
# The business's time zone. Dates in reports count from the day a note was sent there. 330 is India.
FOUNDRY_UTC_OFFSET_MINUTES=330

# The dashboard: uv run --env-file .env python -m foundry.dashboard. It listens on this machine only. Each business lists the logins that can use it in its pack, and a demo's pack can write {switch_email} for SWITCH_EMAIL.
FOUNDRY_DASHBOARD_PORT=8100
# Signs the dashboard's session cookie. Sessions are kept in memory, so restarting the dashboard signs everyone out whether or not this is set. Left empty, each run picks its own.
FOUNDRY_DASHBOARD_SECRET=
# Open jobs. The desk writes them and the dashboard reads them.
FOUNDRY_JOBS_DB=foundry-jobs.db
# What the dashboard asks the desk to do. Left empty, it sits beside the work database.
FOUNDRY_COMMANDS_DB=

# Only for the scripted demos. Mattermost's admin sign-in comes from Switch's .env. scripts/demo_people.py makes the scripted people, writes their made-up password here and writes FOUNDRY_MATTERMOST_BRIDGE above.
MATTERMOST_URL=http://127.0.0.1:8065
MATTERMOST_ADMIN_USER=
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=
FOUNDRY_DEMO_PASSWORD=

# Only with integrations/whatsapp. From your Meta app. tools/connect_whatsapp.py reads them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Slack and Telegram, through Switch's own connections. tools/connect_chat.py connects whichever are filled in.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WORKSPACE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
