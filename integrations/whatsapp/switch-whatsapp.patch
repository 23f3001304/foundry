+def _reply_id(token: str, position: int) -> str:
+    return f"{_PRESS_PREFIX}:{token}:{position}"
+
+
+def _parse_reply_id(reply_id: str) -> tuple[str, int] | None:
+    """The request and control a press names, or None if it is not ours.
+
+    Read as strictly as it is written: this bridge's prefix, a token, and a
+    count in ASCII digits from one.
+    """
+    prefix, _, rest = reply_id.partition(":")
+    token, _, digits = rest.rpartition(":")
+    if prefix != _PRESS_PREFIX or not token:
+        return None
+    if not digits.isascii() or not digits.isdecimal():
+        return None
+    position = int(digits)
+    return (token, position) if position > 0 else None
+
+
+def _title_limit(count: int) -> int:
+    return MAX_BUTTON_TITLE if count <= MAX_REPLY_BUTTONS else MAX_ROW_TITLE
+
+
+def _label_room(count: int) -> int:
+    """How much of a label fits on a control after its number."""
+    return _title_limit(count) - len(f"{count}. ")
+
+
+def _control_title(control: Control, limit: int) -> str:
+    """The option's number and as much of it as fits.
+
+    Numbered because a typed answer names the same number, and because WhatsApp
+    refuses two buttons with one title, which two labels cut short could be.
+    """
+    title = f"{control.position}. {' '.join(control.label.split())}"
+    return title if len(title) <= limit else f"{title[: limit - 1]}…"
+
+
+def _interactive(body: str, controls: list[Control], token: str) -> dict[str, Any]:
+    limit = _title_limit(len(controls))
+    if len(controls) <= MAX_REPLY_BUTTONS:
+        return {
+            "type": "button",
+            "body": {"text": body},
+            "action": {
+                "buttons": [
+                    {
+                        "type": "reply",
+                        "reply": {
+                            "id": _reply_id(token, control.position),
+                            "title": _control_title(control, limit),
+                        },
+                    }
+                    for control in controls
+                ]
+            },
+        }
+    return {
+        "type": "list",
+        "body": {"text": body},
+        "action": {
+            "button": _LIST_BUTTON,
+            "sections": [
